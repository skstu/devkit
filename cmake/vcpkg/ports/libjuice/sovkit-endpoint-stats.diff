+// All callers already hold the connection lock. Do no allocation, file I/O or callbacks.
+static void sovkit_record_endpoint(juice_agent_t *agent, const addr_record_t *record,
+                                   uint8_t kind, size_t bytes, int status) {
+	if (!agent->config.sovkit_endpoint_diagnostics) return;
+	juice_sovkit_check_stats_t *stats = &agent->sovkit_stats;
+	addr_record_t numeric = *record;
+	addr_unmap_inet6_v4mapped((struct sockaddr *)&numeric.addr, &numeric.len);
+	char host[64];
+	if (getnameinfo((const struct sockaddr *)&numeric.addr, numeric.len,
+	                host, sizeof(host), NULL, 0, NI_NUMERICHOST | NI_DGRAM)) {
+		++stats->endpoint_dropped;
+		return;
+	}
+	uint16_t port = addr_get_port((const struct sockaddr *)&numeric.addr);
+	uint8_t family = numeric.addr.ss_family == AF_INET ? 4 : 6;
+	uint64_t now = (uint64_t)current_timestamp();
+	if (!stats->endpoint_started_ms) stats->endpoint_started_ms = now;
+	uint32_t i;
+	for (i = 0; i < stats->endpoint_count; ++i) {
+		juice_sovkit_endpoint_t *item = &stats->endpoints[i];
+		if (item->port == port && item->family == family && item->kind == kind &&
+		    item->send_status == status && !strcmp(item->address, host)) break;
+	}
+	if (i == stats->endpoint_count) {
+		if (i == JUICE_SOVKIT_ENDPOINT_LIMIT) { ++stats->endpoint_dropped; return; }
+		juice_sovkit_endpoint_t *item = &stats->endpoints[stats->endpoint_count++];
+		snprintf(item->address, sizeof(item->address), "%s", host);
+		item->port = port; item->family = family; item->kind = kind; item->send_status = status;
+		item->first_ms = now - stats->endpoint_started_ms;
+	}
+	juice_sovkit_endpoint_t *item = &stats->endpoints[i];
+	++item->count;
+	item->bytes += bytes;
+	item->last_ms = now - stats->endpoint_started_ms;
+}
