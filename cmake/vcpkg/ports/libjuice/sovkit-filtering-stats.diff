+JUICE_EXPORT int juice_sovkit_get_filtering_stats(juice_agent_t *agent,
+                                                 juice_sovkit_mapping_stats_t *stats) {
+	if (!agent || !stats) return JUICE_ERR_INVALID;
+	conn_lock(agent);
+	*stats = agent->sovkit_filtering;
+	stats->enabled = agent->config.sovkit_filtering_second_port != 0;
+	if (stats->state) stats->age_ms = (uint64_t)current_timestamp() - stats->started_ms;
+	conn_unlock(agent);
+	return JUICE_ERR_SUCCESS;
+}
