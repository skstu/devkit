@@ -106,1 +106,15 @@
+JUICE_EXPORT int juice_sovkit_get_pcp_stats(juice_agent_t *agent, juice_sovkit_pcp_stats_t *stats) {
+	if (!agent || !stats) return JUICE_ERR_INVALID;
+	conn_lock(agent);
+	*stats = agent->sovkit_pcp;
+	stats->enabled = agent->config.sovkit_pcp_gateway_ipv4 != 0;
+	uint64_t now = (uint64_t)current_timestamp();
+	stats->remaining_ms = stats->state == 2 && agent->sovkit_pcp_expires > now
+	    ? agent->sovkit_pcp_expires - now : 0;
+	if (stats->state == 2 && !stats->remaining_ms) stats->state = 6;
+	conn_unlock(agent);
+	return JUICE_ERR_SUCCESS;
+}
