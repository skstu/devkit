+// Same-room forwarding preserves standard TURN Data indications while keeping
+// the payload inside this server. No routing to private networks or the Internet.
+static int sovkit_paired_forward(juice_server_t *server, server_turn_alloc_t *source,
+                                  const addr_record_t *peer, const char *data, size_t size) {
+	for (int i = 0; i < server->allocs_count; ++i) {
+		server_turn_alloc_t *target = server->allocs + i;
+		if (target == source || target->state != SERVER_TURN_ALLOC_FULL ||
+		    target->timestamp <= current_timestamp() ||
+		    target->credentials != source->credentials ||
+		    !addr_record_is_equal(&target->sovkit_relayed, peer, true) ||
+		    !turn_has_permission(&target->map, &source->sovkit_relayed))
+			continue;
+		// Recheck permission immediately before forwarding; packet I/O accounts bytes.
+		if (server->config.sovkit_relay_budget &&
+		    !server->config.sovkit_relay_budget(0, server->config.sovkit_user_ptr))
+			return -1;
+		stun_message_t msg;
+		memset(&msg, 0, sizeof(msg));
+		msg.msg_class = STUN_CLASS_INDICATION;
+		msg.msg_method = STUN_METHOD_DATA;
+		msg.peers_size = 1;
+		msg.peers[0] = source->sovkit_relayed;
+		msg.data = data;
+		msg.data_size = size;
+		juice_random(msg.transaction_id, STUN_TRANSACTION_ID_SIZE);
+		return server_stun_send(server, &target->record, &msg, NULL);
+	}
+	return -1;
+}
