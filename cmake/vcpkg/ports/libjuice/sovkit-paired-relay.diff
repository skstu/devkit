+JUICE_EXPORT int juice_server_remove_credentials(juice_server_t *server, const char *username) {
+	if (!server || !username) return -1;
+	mutex_lock(&server->mutex);
+	juice_credentials_list_t **item = &server->credentials;
+	while (*item) {
+		juice_credentials_list_t *node = *item;
+		if (strcmp(node->credentials.username, username) != 0) { item = &node->next; continue; }
+		for (int i = 0; i < server->allocs_count; ++i) {
+			server_turn_alloc_t *alloc = server->allocs + i;
+			if (alloc->state == SERVER_TURN_ALLOC_FULL && alloc->credentials == &node->credentials)
+				delete_allocation(alloc);
+		}
+		*item = node->next;
+		free((void *)node->credentials.username);
+		free((void *)node->credentials.password);
+		free(node);
+	}
+	mutex_unlock(&server->mutex);
+	server_interrupt(server);
 	return 0;
 }
 
